# Copy to .env and edit. .env is git-ignored; never commit real secrets.
# Teacher sign-up needs this code when set (leave empty to allow anyone to sign up as a teacher).
OMR_TEACHER_INVITE=
# Server address and port
OMR_HOST=127.0.0.1
OMR_PORT=8000
# Optional: keep the database / generated exams somewhere else
# OMR_DB=/path/to/platform.db
# OMR_EXAMS_DIR=/path/to/exams

# Address printed inside the QR codes (must be reachable from students' phones, e.g. http://192.168.1.20:8000)
OMR_PUBLIC_URL=http://localhost:8000

# Database. Leave empty to use the local SQLite file. For Supabase (PostgreSQL) paste the *Session pooler* connection string:
# Project -> Connect -> Session pooler, e.g.
# DATABASE_URL=postgresql://postgres.<project-ref>:<YOUR-PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
