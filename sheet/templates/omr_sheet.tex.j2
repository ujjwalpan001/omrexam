(% macro render_question(q, notice=False) %)
\needspace{5\baselineskip}
\item (( q.text ))
  \begin{enumerate}[label=\textbf{\Alph*.},leftmargin=2.4em,itemsep=4pt,parsep=0pt,topsep=5pt]
(% for opt in q.options %)
  \item (( opt.text ))
(% endfor %)
  \end{enumerate}
(% if notice %)
  \aiguard
(% endif %)
(% endmacro %)
